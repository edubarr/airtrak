meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/airtrak.auth.v1.AuthService/Register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "displayName": "{{displayName}}",
    "locale": "{{locale}}"
  }
}

script:post-response {
  if (res.body && res.body.accessToken) {
    bru.setEnvVar("accessToken", res.body.accessToken);
  }
}
