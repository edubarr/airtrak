meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/airtrak.auth.v1.AuthService/Login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  if (res.body && res.body.accessToken) {
    bru.setEnvVar("accessToken", res.body.accessToken);
  }
}
